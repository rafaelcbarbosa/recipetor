# Copy to /etc/recipetor-bridge.env on the server (or bridge/.env for local runs).
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8790

# Required. The app sends this as "Authorization: Bearer <token>".
BRIDGE_TOKEN=change-me

# Extraction backend. Hermes is the only backend for now.
BRIDGE_BACKEND=hermes

# Optional Hermes model/provider overrides. Passed to Hermes as:
#   -m <model> --provider <provider>
#
# Prefer a fast model that does not emit long hidden reasoning. Reasoning-heavy
# models can spend minutes thinking before returning the JSON and exceed
# BRIDGE_TIMEOUT_MS. This NVIDIA NIM model is fast and returns no reasoning
# tokens; change it if it is not available on your account.
BRIDGE_MODEL=poolside/laguna-xs-2.1
BRIDGE_PROVIDER=nvidia

# Request timeout and retry behavior.
BRIDGE_TIMEOUT_MS=180000
BRIDGE_MAX_ATTEMPTS=2

# Only one model call at a time by default.
BRIDGE_MAX_CONCURRENCY=1

# Global safety limit (the app also limits imports per user connection).
BRIDGE_RATE_LIMIT=30
BRIDGE_RATE_WINDOW_MS=3600000

# Hermes executable. Use an absolute path if it is not on the service PATH.
HERMES_BIN=hermes
