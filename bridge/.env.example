# Copy to /etc/recipetor-bridge.env on the server (or bridge/.env for local runs).
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8790

# Required. The app sends this as "Authorization: Bearer <token>".
BRIDGE_TOKEN=change-me

# Extraction backend. Hermes is the only backend for now.
BRIDGE_BACKEND=hermes

# Optional Hermes model/provider overrides. Passed to Hermes as:
#   -m <model> --provider <provider>
#
# This NVIDIA NIM model reasons heavily and can take 5-10 minutes per post, so
# it needs a large timeout. For a faster (but less complete) extraction, use
# poolside/laguna-xs-2.1, which finishes in about 10 seconds.
BRIDGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
BRIDGE_PROVIDER=nvidia

# Request timeout and retry behavior. The timeout is a safety net; this model
# usually answers in 1-2 minutes, but can occasionally return an empty
# instruction list, which is retried.
BRIDGE_TIMEOUT_MS=900000
BRIDGE_MAX_ATTEMPTS=2

# Log extraction progress and a heartbeat while Hermes is running.
BRIDGE_VERBOSE=true
BRIDGE_PROGRESS_INTERVAL_MS=15000

# Only one model call at a time by default.
BRIDGE_MAX_CONCURRENCY=1

# Global safety limit (the app also limits imports per user connection).
BRIDGE_RATE_LIMIT=30
BRIDGE_RATE_WINDOW_MS=3600000

# Hermes executable. Use an absolute path if it is not on the service PATH.
HERMES_BIN=hermes
