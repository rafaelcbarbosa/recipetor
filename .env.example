# Copy to .env and adjust for the deployment environment.
# Bind to 0.0.0.0 only when a trusted reverse proxy/firewall protects the service.
RECIPETOR_HOST=127.0.0.1
RECIPETOR_PORT=8787
RECIPETOR_DB_PATH=./data/recipetor.sqlite

# Secret used to sign login tokens. Set this to a long random value in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a secret is generated once and stored at data/.jwt-secret.
RECIPETOR_JWT_SECRET=

# Optional: restrict browser import requests to this exact public origin.
# RECIPETOR_ORIGIN=https://recipes.example.com

# Email delivery for verification and password reset codes.
# Defaults to a local Postfix relay on port 25 (no authentication).
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM="recipetor <noreply@barbtech.com>"

# Recipe extraction runs the vendored Python pipeline in extractor/.
# Set up once with: bash extractor/setup.sh
RECIPE_EXTRACTOR_PYTHON=./extractor/.venv/bin/python
RECIPE_EXTRACTOR_SCRIPT=./extractor/recipe_extract.py
RECIPE_EXTRACTOR_MODEL=beam-free
RECIPE_EXTRACTOR_BASE_URL=https://opencode.ai/zen/go/v1
# Falls back to OPENCODE_GO_API_KEY or ~/.hermes/.env when empty.
RECIPE_EXTRACTOR_API_KEY=
RECIPE_EXTRACTOR_WHISPER_MODEL=medium
RECIPE_EXTRACTOR_LANGUAGE=auto
RECIPE_EXTRACTOR_OCR_LANGS=por+eng
RECIPE_EXTRACTOR_COMPUTE_NUTRITION=1
RECIPE_EXTRACTOR_TIMEOUT_MS=900000
RECIPETOR_MEDIA_DIR=./data/media
