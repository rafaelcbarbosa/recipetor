[Unit]
Description=Recipetor recipe extractor
After=network-online.target
Wants=network-online.target

[Service]
User=coxinha
Group=coxinha
WorkingDirectory=/home/coxinha/recipetor-extractor
EnvironmentFile=/home/coxinha/.config/recipetor-extractor.env
ExecStart=/home/coxinha/recipetor-extractor/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8099 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
