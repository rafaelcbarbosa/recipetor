[Unit]
Description=Recipetor extractor reverse tunnel
After=network-online.target recipe-extractor.service
Wants=network-online.target

[Service]
User=coxinha
Group=coxinha
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:8099:127.0.0.1:8099 coxinha@192.168.1.200
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
